<%- include('../partials/header',{title:'Reset Password'}) %>
<section class="auth section"><div class="auth-card">
  <span class="eyebrow">ACCOUNT RECOVERY</span><h1>Create a new password</h1>
  <% if(error){ %><div class="alert"><%= error %></div><% } %>
  <form method="post" class="form"><input type="password" name="password" minlength="6" placeholder="New password" required><input type="password" name="confirmPassword" minlength="6" placeholder="Confirm new password" required><button class="btn">Reset password</button></form>
</div></section>
<%- include('../partials/footer') %>

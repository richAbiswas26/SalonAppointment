<%- include('partials/header',{title:'Glow & Care Beauty Salon'}) %>

<section class="hero luxury-hero">
  <div class="hero-slides">
    <% if(heroes.length){ heroes.forEach((h,i)=>{ %>
      <div class="hero-slide <%= i===0?'active':'' %>" style="background-image:url('<%= h.image %>')">
        <div class="hero-overlay"></div>
        <div class="hero-copy">
          <span class="eyebrow light">BEAUTY. CONFIDENCE. YOU.</span>
          <h1><%= h.title %></h1>
          <p><%= h.subtitle %></p>
          <div class="hero-actions">
            <a class="btn" href="/services">Book Appointment <span>→</span></a>
            <a class="btn ghost" href="/services">Explore Services</a>
          </div>
        </div>
      </div>
    <% }) } else { %>
      <div class="hero-slide active hero-placeholder">
        <div class="hero-overlay"></div>
        <div class="hero-copy">
          <span class="eyebrow light">BEAUTY. CONFIDENCE. YOU.</span>
          <h1>Enhancing Beauty,<br><em>Inspiring Confidence</em></h1>
          <p>Professional care, premium products and a personalized experience created for your best self.</p>
          <a class="btn" href="/services">Explore Services →</a>
        </div>
      </div>
    <% } %>
  </div>
  <div class="hero-dots"><% heroes.forEach((h,i)=>{ %><span class="<%= i===0?'active':'' %>"></span><% }) %></div>
</section>

<section class="trust-strip">
  <div><span>✦</span><strong>PROFESSIONAL EXPERTS</strong><small>Highly trained beauty specialists</small></div>
  <div><span>◉</span><strong>PREMIUM PRODUCTS</strong><small>Quality & skin-safe care</small></div>
  <div><span>✧</span><strong>PERSONALIZED CARE</strong><small>Treatments tailored for you</small></div>
  <div><span>♡</span><strong>HYGIENE & SAFETY</strong><small>Clean, safe & comfortable</small></div>
</section>

<section class="section services-showcase">
  <div class="section-head centered-head">
    <div><span class="eyebrow">WHAT WE OFFER</span><h2>Popular Services</h2></div>
    <a class="text-link" href="/services">View all services →</a>
  </div>
  <div class="category-showcase">
    <% categories.slice(0,6).forEach(c=>{ %>
      <a class="showcase-card" href="/services/<%= c._id %>">
        <div class="showcase-image">
          <% if(c.image){ %><img src="<%= c.image %>" alt="<%= c.name %>"><% } else { %><div class="image-placeholder">GC</div><% } %>
          <span class="round-arrow">↗</span>
        </div>
        <h3><%= c.name %></h3>
        <p><%= c.description||'Personalized salon care' %></p>
      </a>
    <% }) %>
  </div>
</section>

<section class="about-feature">
  <div class="about-photo">
    <% if(categories.find(c=>c.image)){ %><img src="<%= categories.find(c=>c.image).image %>" alt="Salon care"><% } else { %><div class="about-placeholder">Your salon image</div><% } %>
    <div class="experience-badge"><strong>10+</strong><span>Years of<br>experience</span></div>
  </div>
  <div class="about-copy">
    <span class="eyebrow">ABOUT US</span>
    <h2>Experience Beauty<br><em>Like Never Before</em></h2>
    <p>At Glow & Care Beauty Salon, we believe beauty is more than an appointment. It is a feeling of confidence, comfort and care. Our team is here to make every visit personal.</p>
    <div class="about-metrics">
      <div><strong>10+</strong><span>Years</span></div>
      <div><strong>5K+</strong><span>Happy clients</span></div>
      <div><strong>20+</strong><span>Experts</span></div>
      <div><strong>100%</strong><span>Care</span></div>
    </div>
    <a class="btn dark" href="/services">Learn more about us</a>
  </div>
</section>

<section class="floating-stats">
  <div><strong>10+</strong><span>Years of experience</span></div>
  <div><strong>5K+</strong><span>Happy clients</span></div>
  <div><strong>20+</strong><span>Beauty experts</span></div>
  <div><strong>100%</strong><span>Personalized care</span></div>
</section>

<section class="section about-story">
  <div class="center">
    <span class="eyebrow">OUR PROMISE</span>
    <h2>Feel cared for. Leave confident.</h2>
    <p>From everyday grooming to special occasions, we combine skilled professionals, quality products and a calm salon experience.</p>
  </div>
</section>

<section class="contact section">
  <div class="map">
    <iframe title="Salon location" src="https://www.google.com/maps?q=Bhopal%20Madhya%20Pradesh&output=embed" loading="lazy"></iframe>
    <a class="map-link" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Bhopal+Madhya+Pradesh">Open in Google Maps ↗</a>
  </div>
  <div class="contact-card">
    <span class="eyebrow">GET IN TOUCH</span>
    <h2>Have a question?</h2>
    <p class="muted">Send us a message and our team will get back to you.</p>
    <form method="post" action="/contact" class="form">
      <input name="name" placeholder="Your name" required>
      <div class="two"><input type="email" name="email" placeholder="Email" required><input name="phone" placeholder="Phone"></div>
      <textarea name="message" placeholder="Your message" required></textarea>
      <button class="btn">Send message →</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
<script>
(function(){
  const slides=[...document.querySelectorAll('.hero-slide')], dots=[...document.querySelectorAll('.hero-dots span')];
  if(slides.length<2)return;
  let i=0;
  setInterval(()=>{
    slides[i].classList.remove('active'); if(dots[i])dots[i].classList.remove('active');
    i=(i+1)%slides.length; slides[i].classList.add('active'); if(dots[i])dots[i].classList.add('active');
  },5000);
})();
</script>

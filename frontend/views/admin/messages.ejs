<%- include('../partials/admin-header',{title:'Queries'}) %><section class="admin-section"><h1>Customer Queries</h1><div class="table-wrap"><table><tr><th>Date</th><th>Name</th><th>Contact</th><th>Message</th><th>Status</th></tr><% messages.forEach(m=>{ %><tr><td><%= m.createdAt.toLocaleDateString() %></td><td><%= m.name %></td><td><%= m.email %><br><%= m.phone||'' %></td><td><%= m.message %></td><td><%= m.status %></td></tr><% }) %></table></div></section><%- include('../partials/admin-footer') %>

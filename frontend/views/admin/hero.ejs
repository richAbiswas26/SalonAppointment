<%- include('../partials/admin-header',{title:'Homepage Slider'}) %>
<section class="admin-section">
  <div class="admin-page-title"><span class="eyebrow">HOMEPAGE</span><h1>Hero Slider</h1><p>Upload salon photographs directly from your device. No image URLs are required.</p></div>
  <div class="admin-panel">
    <form method="post" action="/admin/hero" enctype="multipart/form-data" class="admin-form-grid">
      <input name="title" placeholder="Heading" required><input name="subtitle" placeholder="Subtitle">
      <label class="file-field">Slider image<input name="image" type="file" accept="image/jpeg,image/png,image/webp" required></label>
      <input name="order" type="number" placeholder="Display order" value="0"><button class="btn">Upload image</button>
    </form>
  </div>
  <div class="admin-card-grid">
    <% heroes.forEach(h=>{ %><article class="admin-image-card"><div class="admin-card-image tall"><img src="<%= h.image %>" alt="<%= h.title %>"></div><div class="admin-card-body"><h3><%= h.title %></h3><p><%= h.subtitle %></p><form method="post" action="/admin/hero/<%= h._id %>/delete" onsubmit="return confirm('Delete this slider image?')"><button class="danger-btn">Delete image</button></form></div></article><% }) %>
  </div>
</section>
<%- include('../partials/admin-footer') %>

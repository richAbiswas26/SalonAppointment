<%- include('../partials/header',{title:'Booking History'}) %><section class="section"><h1>Booking History</h1><div class="table-wrap"><table><tr><th>Code</th><th>Date</th><th>Time</th><th>Services</th><th>Total</th><th>Status</th><th></th></tr><% bookings.forEach(b=>{ %><tr><td><%= b.bookingCode %></td><td><%= b.date.toLocaleDateString() %></td><td><%= b.slot %></td><td><%= b.items.map(x=>x.name+' × '+x.members).join(', ') %></td><td>₹<%= b.finalTotal %></td><td><span class="status <%= b.status %>"><%= b.status %></span></td><td><% if(['booked','confirmed'].includes(b.status)){ %><form method="post" action="/booking/<%= b._id %>/cancel"><button>Cancel</button></form><% } %></td></tr><% }) %></table></div></section><%- include('../partials/footer') %>

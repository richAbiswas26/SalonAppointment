<%- include('../partials/header',{title:'Booking History'}) %>
<section class="section"><h1>Booking History</h1>
<div class="table-wrap"><table><tr><th>Code</th><th>Date</th><th>Time</th><th>Services actually provided</th><th>Total</th><th>Status</th><th>Action</th></tr>
<% bookings.forEach(b=>{ const shownItems=b.status==='completed'&&b.finalItems?.length?b.finalItems:b.items; %>
<tr><td><%= b.bookingCode %></td><td><%= b.date.toLocaleDateString() %></td><td><%= b.slot %></td><td><%= shownItems.map(x=>x.name+' × '+x.members).join(', ') %><% if(b.status==='completed'&&b.discountAmount){ %><br><small>Reward discount: <%= b.discountPercent %>% (₹<%= Number(b.discountAmount).toFixed(2) %>)</small><% } %></td><td>₹<%= Number(b.finalTotal||0).toFixed(2) %></td><td><span class="status <%= b.status %>"><%= b.status %></span></td><td><% if(['booked','confirmed'].includes(b.status)){ %><form method="post" action="/booking/<%= b._id %>/cancel" onsubmit="return confirm('Cancel this booking?')"><button type="submit">Cancel</button></form><% } else if(b.status==='cancelled'){ %><small>Cancelled</small><% } else { %><small>Completed</small><% } %></td></tr>
<% }) %></table></div></section><%- include('../partials/footer') %>

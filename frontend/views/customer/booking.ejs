<%- include('../partials/header',{title:'Book Appointment'}) %><section class="section narrow"><h1>Book Appointment</h1><% if (typeof error !== 'undefined' && error) { %><div class="alert"><%= error %></div><% } %><div class="summary-box"><p>Services: <%= items.map(x=>x.name+' × '+x.members).join(', ') %></p><p>Subtotal: ₹<%= items.reduce((a,x)=>a+x.price*x.members,0) %></p><p>Reward discount: <strong id="discount"><%= discount %>%</strong></p><p class="total">Estimated total: ₹<span id="total"><%= items.reduce((a,x)=>a+x.price*x.members,0)*(1-discount/100) %></span></p></div><form method="post" action="/booking" class="form" id="booking-form"><% if(!user){ %><input name="guestName" placeholder="Full name" required><div class="two"><input type="email" name="contactEmail" placeholder="Email"><input name="contactPhone" placeholder="Phone"></div><small>Provide at least email or phone.</small><% }else{ %><div class="two"><input name="contactEmail" value="<%= user.email||'' %>" placeholder="Email"><input name="contactPhone" value="<%= user.phone||'' %>" placeholder="Phone"></div><% } %><label>Date<input id="date" type="date" name="date" required min="<%= new Date().toISOString().slice(0,10) %>"></label><label>Time<select id="slot" name="slot" required><option value="">Select date first</option></select></label><button class="btn">Confirm booking</button></form></section><%- include('../partials/footer') %>

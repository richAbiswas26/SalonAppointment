<%- include('../partials/header',{title:'Cart'}) %><section class="section"><h1>Your Cart</h1><% if(!items.length){ %><div class="empty"><p>Your cart is empty.</p><a class="btn" href="/services">Browse services</a></div><% }else{ %><div class="cart-list"><% items.forEach(i=>{ %><div class="cart-row"><div><h3><%= i.name %></h3><p>₹<%= i.price %> × <%= i.members %> member(s)</p></div><form method="post" action="/cart/update"><input type="hidden" name="serviceId" value="<%= i.serviceId %>"><input type="number" min="1" name="members" value="<%= i.members %>"><button>Update</button></form><form method="post" action="/cart/remove"><input type="hidden" name="serviceId" value="<%= i.serviceId %>"><button>Remove</button></form><strong>₹<%= i.price*i.members %></strong></div><% }) %></div><div class="summary"><h2>Total: ₹<%= subtotal %></h2><a class="btn" href="/booking">Proceed to book</a></div><% } %></section><%- include('../partials/footer') %>

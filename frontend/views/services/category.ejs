<%- include('../partials/header',{title:category.name}) %><section class="section"><a href="/services">← All services</a><span class="eyebrow"><%= category.name %></span><h1><%= category.name %> Services</h1><div class="grid products"><% services.forEach(s=>{ %><article class="product"><% if(s.image){ %><img src="<%= s.image %>" alt="<%= s.name %>"><% } %><div class="product-body"><h3><%= s.name %></h3><p><%= s.description %></p><strong>₹<%= s.price %></strong><form method="post" action="/cart/add" class="inline-form"><input type="hidden" name="serviceId" value="<%= s._id %>"><input type="number" name="members" min="1" value="1"><button class="btn">Add to cart</button></form></div></article><% }) %></div></section><%- include('../partials/footer') %>

<%- include('../partials/header',{title:'Services'}) %><section class="section"><span class="eyebrow">Explore</span><h1>Our Services</h1><div class="grid categories"><% categories.forEach(c=>{ %><a class="category-card" href="/services/<%= c._id %>"><% if(c.image){ %><img src="<%= c.image %>" alt="<%= c.name %>"><% } %><div><h3><%= c.name %></h3><p><%= c.description||'' %></p></div></a><% }) %></div></section><%- include('../partials/footer') %>
